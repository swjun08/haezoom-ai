{
  "name": "haezoom-ai",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write \"extension/*.{js,mjs,css,html}\" cloudflare-worker.js \"scripts/*.mjs\"",
    "format:check": "prettier --check \"extension/*.{js,mjs,css,html}\" cloudflare-worker.js \"scripts/*.mjs\"",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.10.1"
  }
}
