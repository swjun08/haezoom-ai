{
  "manifest_version": 3,
  "name": "해줌 AI — 공지를 내 할 일로",
  "version": "3.0.5",
  "key": "",
  "minimum_chrome_version": "120",
  "description": "공지·PDF·화면을 가져오고 할 일과 마감일을 확인하는 문서 도우미",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "identity",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://tessdata.projectnaptha.com/*",
    "https://haezoom.sleepwhale.workers.dev/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*.pdf",
        "file:///*.PDF"
      ],
      "js": [
        "selection-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "1089348356723-a4isk4ovfbmcco0qginukg126cn31bv6.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "해줌 열기"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_page": "workspace.html#settings",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "open-helper": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "선택한 문장 정리하기 (선택이 없으면 해줌 메뉴 열기)"
    },
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "화면 캡처로 공지 가져오기"
    }
  }
}
